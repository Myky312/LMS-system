# Database — use 127.0.0.1 (not localhost) so Docker Postgres is used on macOS (localhost can resolve to IPv6 ::1).
# If you use local Postgres (not Docker), create zeekr_user first: psql -U postgres -h 127.0.0.1 -f docs/init-local-postgres.sql
DATABASE_URL=postgresql://zeekr_user:zeekr_pass@127.0.0.1:5432/zeekracademy

# Test DB (only for E2E: pnpm test:e2e). Separate DB; schema synced before each test run.
TEST_DATABASE_URL=postgresql://zeekr_user:zeekr_pass@127.0.0.1:5432/zeekracademy_test

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3-compatible storage (MinIO or AWS S3)
# MinIO (local): use S3_ENDPOINT and S3_FORCE_PATH_STYLE=true
# AWS S3 (prod): leave S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false
S3_REGION=us-east-1
S3_BUCKET=zeekr-academy-media
S3_BUCKET_TEST=zeekr-academy-media-test
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Server
PORT=3000

# Logging: info | debug | warn | error. Default: production=info, else=debug
# LOG_LEVEL=info
