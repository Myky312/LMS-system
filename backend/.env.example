# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lms

# Test DB (required for E2E). Separate database; schema is synced from migrations before each test run.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/lms_test

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3-compatible storage (MinIO or AWS S3)
# MinIO (local): use S3_ENDPOINT and S3_FORCE_PATH_STYLE=true
# AWS S3 (prod): leave S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false
S3_REGION=us-east-1
S3_BUCKET=lms-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Server
PORT=3000
