      "static/chunks/main-app.js",
      "static/chunks/app/(panel)/courses/[courseId]/modules/[moduleId]/page.js"
    ],
    "/(panel)/courses/[courseId]/modules/[moduleId]/lessons/new/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(panel)/courses/[courseId]/modules/[moduleId]/lessons/new/page.js"
    ],
    "/(panel)/courses/[courseId]/modules/[moduleId]/lessons/[lessonId]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(panel)/courses/[courseId]/modules/[moduleId]/lessons/[lessonId]/page.js"
    ],
    "/(panel)/submissions/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(panel)/submissions/page.js"
    ],
    "/(panel)/courses/page": [
